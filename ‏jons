

({"file_text":"\"\"\"Apps / channels directory routes — internal index search for FHDxEXNL.x.\"\"\"\n\nimport re\nfrom typing import Optional\n\nfrom fastapi import APIRouter, Query\nfrom pymongo import ASCENDING\n\nfrom lib.db import db\nfrom models.models import AppListResponse\n\nrouter = APIRouter()\n\n\n@router.get(\"/apps\", response_model=AppListResponse)\nasync def list_apps(\n    category: Optional[str] = Query(default=None, pattern=\"^(social|software|channels)$\"),\n    q: Optional[str] = Query(default=None, max_length=100),\n    trending: Optional[bool] = None,\n    limit: int = Query(default=60, ge=1, le=200),\n) -> AppListResponse:\n    query: dict = {}\n    if category:\n        query[\"category\"] = category\n    if trending is not None:\n        query[\"trending\"] = trending\n    if q:\n        rx = {\"$regex\": re.escape(q), \"$options\": \"i\"}\n        query[\"$or\"] = [\n            {\"name\": rx},\n            {\"name_ar\": rx},\n            {\"description_ar\": rx},\n          {\"tags\": rx},\n        ]\n    docs = await db.apps.find(query).sort(\"rank\", ASCENDING).to_list(limit)\n    items = [AppItem(**doc) for doc in docs]\n    return AppListResponse(items=items, total=len(items))","path":"/app/backend/routers/directory.py"})
